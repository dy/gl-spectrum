{
  "name": "gl-spectrum",
  "version": "4.0.0",
  "description": "WebGL2 spectrum renderer: the loudest bin per pixel column, a line through sparse bins, fill colored by level",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
